root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.s]
indent_style = tab

[{Makefile,*.mk}]
indent_style = tab

[*.{py,yml,yaml,md}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[third_party/**]
trim_trailing_whitespace = false
insert_final_newline = false
